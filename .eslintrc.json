{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "airbnb-base",
        "airbnb-typescript/base"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": ["@typescript-eslint"],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "project": "./tsconfig.json"
    },
    "rules": {
        "import/no-cycle": 0,
        "func-names": 0,
        "no-param-reassign": 0,
        "no-underscore-dangle": 0,
        "class-methods-use-this": ["error", {
            "enforceForClassFields": false
        }],
        "no-console": 0
    }
}
