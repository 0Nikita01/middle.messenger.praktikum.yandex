{{#> Content}}
    {{#> SideBar}}
        {{{ ProfileLink src='/' name=this.user.first_name onClick=this.openChats}}}
        {{#> ChatsBlock}}
        {{/ChatsBlock}}
    {{/SideBar}}
    {{#> Container alignTop=true}}
        {{{ Header text='Профиль'}}}
        <div class='profile__wrapper'>
            <div class='profile__container'>
                {{# Form onSubmit=this.onSubmit}}
                    <div class='profile__info'>
                        {{{ Avatar name='avatar' src='/icons/avatar.png' size='_big'}}}
                        <div class='profile__info__inputs profile__info__inputs_main'>
                            {{#each inputsMain}}
                                {{{ Input   
                                    label=this.label 
                                    type=this.type 
                                    name=this.name 
                                    value=this.value 
                                    mod=this.mod 
                                    onClick=this.onClick 
                                    onBlur=this.onBlur
                                    error=this.error
                                    errorLabel=this.errorLabel
                                }}}
                            {{/each}}
                        </div>
                    </div>
                    <div class='profile__info'>
                        <div class='profile__info__inputs profile__info__inputs_secondary'>
                            {{#each inputsDetails}}
                                {{{ Input   
                                    label=this.label 
                                    type=this.type 
                                    name=this.name 
                                    value=this.value 
                                    mod=this.mod 
                                    onClick=this.onClick 
                                    onBlur=this.onBlur
                                    error=this.error
                                    errorLabel=this.errorLabel
                                }}}
                            {{/each}}
                        </div>
                    </div>
                    <div class='profile__info'>
                        <div class='profile__info__buttons'>
                            {{#each buttons}}
                                {{{ Button 
                                    type=this.type
                                    text=this.text
                                    mod=this.mod
                                    onClick=this.onClick
                                }}}
                            {{/each}}
                        </div>
                    </div>
                {{/Form}}
            </div>
        </div>
    {{/Container}}
{{/Content}}
