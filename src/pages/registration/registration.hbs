{{#> Modal type='auth' text='Регистрация'}}
    {{# Form onSubmit=this.onSubmit}}
        {{#each inputs}}
            {{{ Input   
                label=this.label 
                type=this.type 
                name=this.name 
                value=this.value 
                mod=this.mod 
                onClick=this.onClick 
                onBlur=this.onBlur
                error=this.error
                errorLabel=this.errorLabel
            }}}
        {{/each}}
        {{#each buttons}}
            {{{ Button text=this.text type=this.type mod=this.mod onClick=this.onClick}}}
        {{/each}}
    {{/Form}}
{{/Modal}}
