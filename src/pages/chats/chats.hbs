<div class="wrapper">
    {{#> Modal text=this.modalText type=this.modalType hidden=this.isModalHide mode=this.modalMod}}
        {{# Form}}
            {{#each inputs}}
                {{{ Input label=this.label type=this.type name=this.name mod=this.mod onClick=this.onClick }}}
            {{/each}}
            {{#each buttons}}
                {{{ Button text=this.text type=this.type mod=this.mod onClick=this.onClick}}}
            {{/each}}
        {{/Form}}
    {{/Modal}}
    {{#> Content}}
        {{#> SideBar}}
            {{{ ProfileLink src='/' name=this.user.first_name showProfile='profile' onClick=this.openProfile}}}
            {{# ChatsBlock}}
            {{/ChatsBlock}}
        {{/SideBar}}
        {{#> Container}}
            {{{ Header openModal=this.openModal avatar='/icons/avatar.png' text='User' menu='dots'}}}
            <div class='main'>
                {{# Feed}}{{/Feed}}
                {{{ Message openModal=this.openModal}}}
            </div>
        {{/Container}}
    {{/Content}}
</div>

