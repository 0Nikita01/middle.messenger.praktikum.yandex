<div class='contextmenu contextmenu_{{this.type}} {{#if isHide}}contextmenu_{{this.type}}_hidden{{/if}}'>
    <div class='contextmenu__items contextmenu_{{this.type}}'>
        {{#each items}}
            <div class='contextmenu__item contextmenu_{{type}}' current-modal='{{this.modal}}'>
                <div class='contextmenu__img contextmenu_{{type}}__img' current-modal='{{this.modal}}'>
                    <img 
                        src='{{this.img}}' 
                        alt='' 
                        {{#if mod}}class='contextmenu__img{{mod}} contextmenu_{{type}}'{{/if}} 
                        current-modal='{{this.modal}}'
                    >
                </div>
                <div class='contextmenu__text contextmenu_{{type}}' current-modal='{{this.modal}}'>{{this.text}}</div>
            </div>
        {{/each}}
    </div>
</div>
