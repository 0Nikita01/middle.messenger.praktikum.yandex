<div class='header'>
    <div class='header__descr'>
        <div class='header__descr-items'>
            {{#if avatar}}
                <div class='header__descr-item'>
                    {{{ Avatar src=this.avatar size='_small'}}}
                </div>
            {{/if}}
            {{#if text}}
                <div class='header__descr-item'>
                    <div class='header__descr-text'>
                            {{this.text}}
                    </div>     
                </div>
            {{/if}}
        </div>
    </div>
    {{#if menu}}
        <div class='header__menu'>
            <div class='menu__items' contextmenu='changeUser'>
                <div class='menu__item'></div>
                <div class='menu__item'></div>
                <div class='menu__item'></div>
            </div>
            {{{ ContextMenu isHide=this.hideContext type='header' items=this.menuItems onClick=this.onClick}}}
        </div>
    {{/if}}
</div>
